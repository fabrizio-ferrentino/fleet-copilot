# Copy to .env and adjust as needed. Values below are local-development defaults.
# Real secrets (e.g. the LLM API key, arriving in milestone 3) must only ever live in .env.

# PostgreSQL / TimescaleDB (used by docker-compose and the platform)
# The container is published on host port 5433 (5432 inside Docker) so it
# never clashes with a locally installed PostgreSQL.
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleet
DB_PORT=5433

# MQTT broker (used by the simulator and the platform)
MQTT_HOST=localhost
MQTT_PORT=1883

# Simulator
DEVICES=300
INTERVAL=5
# Startup faults, comma-separated (also injectable at runtime via the fleet/control topic)
# FAULTS=dev-042:silent,dev-007:error_burst

# Platform
PLATFORM_PORT=8080
# A device is offline when not seen for longer than this (shorten for demos/tests)
OFFLINE_THRESHOLD=10m
